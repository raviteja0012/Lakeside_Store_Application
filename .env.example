# Supabase. Create a project in a Canadian region (ca-central, Toronto).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auth switch. Leave unset or "false" for demo mode: open access, no login, the
# "Acting as" picker stays (current behavior). Set to "true" only after the production
# cutover (enable Email auth, create accounts, link app_user.auth_id, run
# supabase/auth_setup.sql). When "true", login is required and per-store, per-role
# policies apply. See RUNBOOK.md "Go to enforced auth (production)".
NEXT_PUBLIC_REQUIRE_AUTH=

# Anthropic. Server-side only, never exposed to the browser.
ANTHROPIC_API_KEY=
# Set to the current Sonnet model id. Check docs.claude.com for the exact string.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Email due-date alerts via Resend. Server-side only. /api/alerts no-ops without these.
RESEND_API_KEY=
# Verified sender, e.g. "Robinsons Alerts <alerts@yourdomain.com>".
ALERT_EMAIL_FROM=
# Where the daily alert goes. Comma-separate for more than one recipient.
ALERT_EMAIL_TO=
# Shared secret for the daily cron. The cron sends it as the x-cron-secret header.
CRON_SECRET=
